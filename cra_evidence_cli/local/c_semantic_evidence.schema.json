{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craevidence.com/schemas/c-semantic-evidence-v2.json",
  "title": "CRA Evidence C semantic evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "adapter", "isolation", "source", "analysis"],
  "properties": {
    "schema_version": {"const": "craevidence.c_semantic_evidence.v2"},
    "language": {"const": "c"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "analyzer_sha256", "library_path", "library_sha256", "library_version", "resource_headers_sha256"],
      "properties": {
        "profile": {
          "enum": [
            "libclang-18-c17-security-evidence-v2",
            "libclang-18.1.8-debian13-c17-security-evidence-v2"
          ]
        },
        "analyzer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "library_path": {"type": "string", "minLength": 1},
        "library_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "library_version": {
          "enum": [
            "Ubuntu clang version 18.1.3 (1ubuntu1)",
            "Debian clang version 18.1.8 (18+b1)"
          ]
        },
        "resource_headers_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "isolation": {
      "const": {
        "build_system_executed": false,
        "compiler_plugins_loaded": false,
        "linker_executed": false,
        "target_code_executed": false,
        "network_required": false,
        "analysis_mode": "libclang-frontend-only"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "files"],
      "properties": {
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_options", "profile_sha256", "occurrences"],
      "properties": {
        "compiler_options": {"type": "array", "items": {"type": "string"}},
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "occurrences": {
          "type": "array",
          "maxItems": 2000000,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "start_line", "start_column", "end_line", "end_column", "index", "classification"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "start_line": {"type": "integer", "minimum": 1},
                  "start_column": {"type": "integer", "minimum": 1},
                  "end_line": {"type": "integer", "minimum": 1},
                  "end_column": {"type": "integer", "minimum": 1},
                  "index": {"type": "integer", "minimum": 0, "maximum": 999999999},
                  "classification": {"enum": ["fixed-array-out-of-bounds-write", "not-compiler-attested"]}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "start_line", "start_column", "end_line", "end_column", "callee", "parameter", "classification"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "start_line": {"type": "integer", "minimum": 1},
                  "start_column": {"type": "integer", "minimum": 1},
                  "end_line": {"type": "integer", "minimum": 1},
                  "end_column": {"type": "integer", "minimum": 1},
                  "callee": {"enum": ["printf", "system"]},
                  "parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                  "classification": {"enum": ["system-printf-main-argv-format", "printf-main-argv-not-system-bound", "system-shell-main-argv-command", "system-main-argv-not-system-bound"]}
                }
              }
            ]
          }
        }
      }
    }
  }
}
